<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Portfólio | Desenvolvedora</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
/* Básico e fundo */
html, body { overflow-x:hidden; width:100%; transition:0.3s; text-align:center; }
body {
  background: radial-gradient(circle at top,#111 0%,#000 60%);
  color:#fff;
  font-family:'Segoe UI',sans-serif;
  position: relative;
}
.tech-glow { color:#ff4ecd; text-shadow:0 0 14px rgba(255,78,205,.7); transition:0.3s; }

/* DECORAÇÕES TECH */
.background-effects { position: fixed; inset:0; overflow:hidden; pointer-events:none; z-index:0; }
.glow-circle { position:absolute; border-radius:50%; filter:blur(40px); transition:0.3s; }
.glow-circle.glow-1 { width:280px; height:280px; top:-80px; left:-80px; background: radial-gradient(circle, rgba(255,78,205,0.35), transparent 70%); }
.glow-circle.glow-2 { width:280px; height:280px; top:240px; right:-100px; background: radial-gradient(circle, rgba(255,78,205,0.35), transparent 70%); }
.glow-dot { position:absolute; width:10px; height:10px; background:#ff4ecd; border-radius:50%; filter:blur(4px); }
.glow-line { position:absolute; width:60px; height:2px; background:#ff4ecd; opacity:0.3; transform:rotate(45deg); filter:blur(2px); }

/* MENU */
.navbar { background: rgba(0,0,0,.7); transition:0.3s; }
.navbar-light .nav-link { color:#fff; transition:0.3s; }
.navbar-toggler-icon { filter:invert(1); }

/* PROFILE */
.profile-pic { width:140px; height:140px; border-radius:50%; object-fit:cover; border:3px solid #ff4ecd; box-shadow:0 0 30px rgba(255,78,205,.5); margin:0 auto 20px auto; display:block; transition:0.3s; }

/* CARDS PROJETOS */
.project-card { background:#111; border-radius:25px; padding:15px; cursor:pointer; transition:.3s; flex:0 0 auto; width:220px; margin-right:15px; }
.project-card:hover { transform:translateY(-6px); box-shadow:0 0 30px rgba(255,0,150,0.25);}
.projects-row { display:flex; overflow-x:auto; padding-bottom:15px; justify-content:center;}
.projects-row::-webkit-scrollbar { display:none; }
.project-card img { border-radius:12px; height:160px; object-fit:cover; width:100%; }
.project-desc { font-size:0.85rem; color:#ccc; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* MODAL */
.modal-content { background:#0e0e0e; border-radius:20px; border:1px solid #333; box-shadow:0 0 40px rgba(255,78,205,.15); transition:0.3s;}
.modal-header { border-bottom:none !important; display:flex; justify-content:space-between; align-items:center; }
.modal-header .btn-close { filter:invert(1); transition:0.3s; }

#modalImage {
  max-width:70vw;
  max-height:60vh;
  width:auto;
  height:auto;
  object-fit:contain;
  border-radius:12px;
}

.modal-description { margin-top:15px; max-height:200px; overflow-y:auto; text-align:left; color:#ccc; }

/* MODAL BOTÕES */
.modal-footer .btn { 
  background: linear-gradient(135deg,#ff4ecd,#7f00ff); 
  border:none; 
  color:#fff; 
  font-weight:600; 
  border-radius:20px; 
  transition:.3s; 
}
.modal-footer .btn:hover { opacity:.85; }

/* CONTACT */
.contact-btn { background: linear-gradient(135deg,#ff4ecd,#7f00ff); padding:15px 30px; border-radius:30px; color:#fff; font-weight:600; text-decoration:none; margin:5px; display:inline-block; }
.social-icons { margin-top:15px; }
.social-icons a { margin:0 15px; font-size:28px; color:#fff; transition:.3s; }
.social-icons a:hover { color:#ff4ecd; }

/* THEME BUTTON */
#themeToggle { 
  border:none; 
  background: linear-gradient(135deg,#ff4ecd,#7f00ff); 
  padding:10px 25px; 
  border-radius:25px; 
  color:#fff; 
  font-weight:600; 
  cursor:pointer; 
  transition:.3s; 
  margin-top:15px; 
}
#themeToggle:hover { opacity:.85; }

/* THEMES */
.light-theme { background:#f5f5f5; color:#111; }
.light-theme .navbar { background: rgba(255,255,255,0.9); }
.light-theme .navbar-light .nav-link { color:#111; }
.light-theme .profile-pic { border:3px solid #ff80bf; box-shadow:0 0 30px rgba(255,128,191,.5); }
.light-theme .modal-content { background:#fff; color:#111; border:1px solid #ccc; }
.light-theme .contact-btn { background: linear-gradient(135deg,#ff80bf,#ff4ecd); color:#fff; }
.light-theme .social-icons a { color:#111; }
.light-theme #themeToggle { background: linear-gradient(135deg,#ff80bf,#ff4ecd); }
.light-theme .modal-footer .btn { background: linear-gradient(135deg,#ff80bf,#ff4ecd); color:#fff; }
.light-theme .modal-header .btn-close { filter: invert(0); }

/* FOOTER */
footer { opacity:.6; font-size:14px; text-align:center; margin-top:50px;}

/* RESPONSIVO */
@media(max-width:800px){
  .carousel img{height:auto;}
  .project-card{width:160px;}
  .profile-pic{width:120px; height:120px;}
  #modalImage{max-width:90vw; max-height:50vh;}
}
</style>
</head>
<body>

<!-- MENU -->
<nav class="navbar navbar-expand-lg navbar-light fixed-top">
  <div class="container-fluid">
    <a class="navbar-brand text-white" href="#">Meu Portfólio</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="#sobre">Sobre mim</a></li>
        <li class="nav-item"><a class="nav-link" href="#portfolio">Portfólio</a></li>
        <li class="nav-item"><a class="nav-link" href="#formacao">Formação</a></li>
        <li class="nav-item"><a class="nav-link" href="#contato">Contato</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- BACKGROUND DECORATIVO -->
<div class="background-effects">
  <div class="glow-circle glow-1"></div>
  <div class="glow-circle glow-2"></div>

  <div class="glow-dot" style="top:50px; left:30px;"></div>
  <div class="glow-dot" style="top:200px; right:80px;"></div>
  <div class="glow-dot" style="bottom:150px; left:100px;"></div>
  <div class="glow-dot" style="bottom:100px; right:150px;"></div>

  <div class="glow-line" style="top:100px; left:100px; transform:rotate(45deg);"></div>
  <div class="glow-line" style="bottom:150px; right:50px; transform:rotate(-30deg);"></div>
</div>

<!-- CONTEÚDO -->
<div class="container py-5 content" id="sobre">
  <img src="https://via.placeholder.com/300x300?text=Foto" class="profile-pic">
  <h1 class="tech-glow">Olá, eu sou desenvolvedora</h1>
  <p class="mt-3 col-md-8 mx-auto">
    Desenvolvedora com foco em <strong>UX, landing pages e sistemas de dados</strong>.<br>
    Transformo abstrações do mundo real em soluções digitais funcionais,<br>
    com experiência em ambientes corporativos e industriais.
  </p>
  <button id="themeToggle">🌙 Tema</button>
</div>

<!-- PORTFÓLIO -->
<div class="container py-5" id="portfolio">
  <h2 class="mb-4">Portfólio</h2>
  <div class="projects-row" id="projectsRow"></div>
</div>

<!-- MODAL -->
<div class="modal fade" id="projectModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content p-3">
      <div class="modal-header">
        <h4 id="modalTitle"></h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <img id="modalImage" src="">
        <div class="modal-description" id="modalDescription"></div>
      </div>
      <div class="modal-footer justify-content-between">
        <button class="btn" id="prevImage">&laquo; Anterior</button>
        <button class="btn" id="nextImage">Próxima &raquo;</button>
      </div>
    </div>
  </div>
</div>

<!-- SCRIPTS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const projects = [
  {title:"Projeto 1", description:"Descrição longa do Projeto 1...", images:["https://via.placeholder.com/800x500","https://via.placeholder.com/800x500"]},
  {title:"Projeto 2", description:"Descrição longa do Projeto 2...", images:["https://via.placeholder.com/800x500"]},
  {title:"Projeto 3", description:"Descrição longa do Projeto 3...", images:["https://via.placeholder.com/800x500"]},
  {title:"Projeto 4", description:"Descrição longa do Projeto 4...", images:["https://via.placeholder.com/800x500"]}
];

const projectsRow = document.getElementById("projectsRow");
projects.forEach((p,i)=>{
  const descShort = p.description.length>30 ? p.description.slice(0,30)+"..." : p.description;
  projectsRow.innerHTML += `
    <div class="project-card" onclick="openModal(${i})">
      <img src="${p.images[0]}" alt="${p.title}">
      <h6 class="mt-2">${p.title}</h6>
      <p class="project-desc">${descShort}</p>
    </div>`;
});

let currentProjectIndex = 0;
let currentImageIndex = 0;

function openModal(i){
  currentProjectIndex = i;
  currentImageIndex = 0;
  showModalImage();
  new bootstrap.Modal(document.getElementById("projectModal")).show();
}

function showModalImage(){
  const p = projects[currentProjectIndex];
  document.getElementById("modalImage").src = p.images[currentImageIndex];
  document.getElementById("modalTitle").innerText = p.title;
  document.getElementById("modalDescription").innerText = p.description;
}

document.getElementById("prevImage").addEventListener("click", ()=>{
  const p = projects[currentProjectIndex];
  currentImageIndex = (currentImageIndex-1+p.images.length)%p.images.length;
  showModalImage();
});
document.getElementById("nextImage").addEventListener("click", ()=>{
  const p = projects[currentProjectIndex];
  currentImageIndex = (currentImageIndex+1)%p.images.length;
  showModalImage();
});

// Tema noite/dia
const themeToggle = document.getElementById("themeToggle");
themeToggle.addEventListener("click", ()=>{
  document.body.classList.toggle("light-theme");
  themeToggle.textContent = document.body.classList.contains("light-theme")?"🌙 Tema":"☀️ Tema";
});
</script>
</body>
</html>
